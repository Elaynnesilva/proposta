rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // leitura aberta: necessário para o link público (o cliente vê a marca/textos padrão sem login).
      // continua incluindo só marca e textos padrão — nenhuma proposta é lida por aqui.
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;

      match /proposals/{proposalId} {
        // a dona da conta sempre pode ler/escrever; qualquer pessoa só pode LER se a
        // proposta tiver sido marcada como "public" (botão "Link para o cliente")
        allow read: if (request.auth != null && request.auth.uid == userId) || resource.data.public == true;
        allow write: if request.auth != null && request.auth.uid == userId;

        // fotos dos slides: cada uma é um documento pequeno aqui dentro (em vez de ir direto
        // no documento da proposta, que tem limite de 1MB). Mesma regra de leitura da
        // proposta em si — se a proposta é pública, a foto lida por ela também precisa ser
        match /media/{mediaId} {
          allow read: if (request.auth != null && request.auth.uid == userId) ||
                         get(/databases/$(database)/documents/users/$(userId)/proposals/$(proposalId)).data.public == true;
          allow write: if request.auth != null && request.auth.uid == userId;
        }
      }

      match /events/{eventId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // biblioteca de imagens da CONTA: fotos que valem para várias propostas (uma tipologia
      // inteira ou todas). Ficam aqui, e não dentro de uma proposta, porque são reaproveitadas
      // por todas elas. Leitura aberta pelo mesmo motivo do documento do usuário logo acima:
      // o link público da apresentação precisa conseguir mostrar essas fotos sem login.
      match /media/{mediaId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
