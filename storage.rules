rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/videos/{allPaths=**} {
      allow read: if true; // o vídeo precisa ser visível na apresentação, inclusive por quem não está logado (o cliente)
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
